{
  "name": "foundry",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/protocol",
    "packages/daemon",
    "packages/cli",
    "packages/host",
    "packages/extension",
    "packages/testkit"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "clean": "tsc -b --clean"
  },
  "devDependencies": {
    "@cloudflare/oxlint-config": "0.2.0",
    "@oxlint/plugins": "1.95.0",
    "@types/node": "22.20.5",
    "eslint-plugin-perfectionist": "5.14.0",
    "oxlint": "1.95.0",
    "tsrs": "7.1.0-beta.tsrs5",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
