{
  "name": "@foundry/protocol",
  "version": "0.0.0",
  "private": true,
  "description": "Channel frames defined once in Schema, shared by the daemon and the Foundry Pi extension.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./management-api": {
      "types": "./dist/management-api.d.ts",
      "default": "./dist/management-api.js"
    },
    "./tickets-api": {
      "types": "./dist/tickets-api.d.ts",
      "default": "./dist/tickets-api.js"
    },
    "./log-query": {
      "types": "./dist/log-query.d.ts",
      "default": "./dist/log-query.js"
    },
    "./log-read": {
      "types": "./dist/log-read.d.ts",
      "default": "./dist/log-read.js"
    },
    "./holds": {
      "types": "./dist/holds.d.ts",
      "default": "./dist/holds.js"
    },
    "./state-root": {
      "types": "./dist/state-root.d.ts",
      "default": "./dist/state-root.js"
    }
  },
  "files": ["dist"],
  "dependencies": { "effect": "4.1.5" }
}
