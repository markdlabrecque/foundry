{
  "name": "@foundry/daemon",
  "version": "0.0.0",
  "private": true,
  "description": "The Foundry daemon: an Effect 4 program and the only process that opens the database.",
  "type": "module",
  "bin": { "foundry-daemon": "./dist/main.js" },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./state-root": {
      "types": "./dist/state-root.d.ts",
      "default": "./dist/state-root.js"
    }
  },
  "files": ["dist"],
  "dependencies": { "@effect/platform-node": "4.1.5", "@effect/sql-sqlite-node": "4.1.5", "@foundry/protocol": "0.0.0", "effect": "4.1.5", "ignore": "7.0.8", "yaml": "2.9.0" }
}
