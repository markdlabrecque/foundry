{
  "tmp": "<CHECK_ROOT>/t",
  "node": "<NODE>",
  "childTmpdir": "shared testkit propagation; no FOUNDRY_PI_BIN override",
  "commands": [
    {
      "name": "build",
      "command": "npm",
      "args": [
        "run",
        "build"
      ],
      "exit": 0,
      "signal": null
    },
    {
      "name": "typecheck",
      "command": "npm",
      "args": [
        "run",
        "typecheck"
      ],
      "exit": 0,
      "signal": null
    },
    {
      "name": "oxlint",
      "command": "./node_modules/.bin/oxlint",
      "args": [],
      "exit": 0,
      "signal": null
    },
    {
      "name": "vitest",
      "command": "./node_modules/.bin/vitest",
      "args": [
        "run"
      ],
      "exit": 0,
      "signal": null
    },
    {
      "name": "e2e",
      "command": "npm",
      "args": [
        "run",
        "test:e2e"
      ],
      "exit": 0,
      "signal": null
    }
  ]
}
